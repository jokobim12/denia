// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Photo {
  id          String   @id @default(cuid())
  imageUrl    String
  title       String
  description String
  eventDate   DateTime
  createdAt   DateTime @default(now())
}

model Letter {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   // e.g. 'sad', 'tired', 'happy', 'cheer'
  createdAt DateTime @default(now())
}

model Timeline {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  eventDate   DateTime
  createdAt   DateTime @default(now())
}

model BucketItem {
  id          String    @id @default(cuid())
  title       String
  category    String    // 'travel', 'food', 'activity', 'dream'
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

model MemorySpot {
  id          String    @id @default(cuid())
  title       String
  description String
  category    String    // 'first-meet', 'date', 'favorite', 'travel'
  latitude    Float
  longitude   Float
  imageUrl    String?
  date        DateTime?
  createdAt   DateTime  @default(now())
}

